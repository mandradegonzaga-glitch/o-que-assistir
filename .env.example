# 4. Adicione .env ao .gitignore
#
# ================================================

# URL do seu projeto Supabase
# Encontre em: Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública anônima
# Encontre em: Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhxZmN3a3p6b3JtZ3F0ZG9nZ3p1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3MDEzNjAwMDAsImV4cCI6MjAxNjkzNjAwMH0.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================================
# CONFIGURAÇÃO PARA PRODUÇÃO
# ================================================
#
# Para usar em produção com variáveis de ambiente:
#
# 1. Adicione .env ao .gitignore:
#    echo ".env" >> .gitignore
#
# 2. No seu ambiente de produção (Vercel, Netlify, etc),
#    configure estas variáveis nas settings do projeto
