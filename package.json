{
  "name": "oqueassistir",
  "version": "1.0.0",
  "description": "App de descoberta gamificada de filmes e séries",
  "type": "module",
  "scripts": {
    "start": "npx -y http-server -p 5173 -c-1 --silent",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js --coverage",
    "test:e2e": "playwright test --config config/playwright.config.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run test:db && npm run test:e2e",
    "test:db": "node --test tests/database/friends.test.mjs tests/database/userLists.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
